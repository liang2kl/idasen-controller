    "Keep the desk nearby. To pair it for the first time, hold its Bluetooth button until the light blinks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让升降桌靠近电脑。首次配对时，请按住桌子上的蓝牙按钮，直到指示灯闪烁。"
          }
        }
      }
    },
    "Launch at Login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时启动"
