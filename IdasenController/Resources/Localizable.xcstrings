  "strings": {
    "Add Preset": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加预设"
          }
        }
      }
    },
    "Allow Idasen to use Bluetooth in System Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”中允许 Idasen 使用蓝牙。"
          }
        }
      }
    },
    "Bluetooth access denied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
